<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Autofac" Version="9.1.0" />
        <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageVersion Include="Dapper" Version="2.1.79" />
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.1" />
        <PackageVersion Include="Polly" Version="8.6.6" />
        <PackageVersion Include="System.Threading.Tasks.Dataflow" Version="10.0.8" />
        <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.ProjectionHandling.Runner" Version="16.0.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.ProjectionHandling.Connector" Version="16.0.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.ProjectionHandling.SqlStreamStore.Autofac" Version="16.0.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.AggregateSource.SqlStreamStore.Autofac" Version="11.0.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.EventHandling.Autofac" Version="7.1.0" />
        <PackageVersion Include="AutoFixture" Version="4.18.1" />
        <PackageVersion Include="AutoFixture.Idioms" Version="4.18.1" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />

        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.categories" Version="3.0.1" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="FluentAssertions" Version="[7.1.0,8.0.0)" />
        <PackageVersion Include="SourceLink.Embed.AllSourceFiles" Version="2.8.3" />
        <PackageVersion Include="SourceLink.Copy.PdbFiles" Version="2.8.3" />
    </ItemGroup>
</Project>
